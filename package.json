{
  "name": "pi-wai-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "WAI Advisor (Whatley AI Advisor): a standalone, source-aware, read-only second-opinion advisor extension for Pi.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatley95/pi-wai-advisor.git"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@earendil-works/pi-tui": "1.3.0"
  }
}
